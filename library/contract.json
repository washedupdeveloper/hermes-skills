{
  "schema": "skill-contract/v3",
  "description_window": 57,
  "required_frontmatter": [
    "name",
    "description",
    "version",
    "author",
    "license",
    "platforms"
  ],
  "categories": [
    "autonomous-ai-agents",
    "communication",
    "devops",
    "docs",
    "note-taking",
    "productivity",
    "security",
    "software-development"
  ],
  "support_dirs": [
    "assets",
    "references",
    "templates",
    "scripts",
    "examples"
  ],
  "hosts": [
    "hermes",
    "claude",
    "codex",
    "opencode",
    "cursor",
    "gemini"
  ],
  "external_skills": [
    "github",
    "grounded-citations",
    "hermes-agent",
    "hermes-agent-skill-authoring",
    "llm-wiki",
    "obsidian",
    "requesting-code-review",
    "reviewer-security",
    "systematic-debugging",
    "test-driven-development"
  ],
  "gate_command": "python3 scripts/validate.py",
  "_why": "One home for the values every enforcer reads: scripts/validate.py (the gate, standard library only) and nix/checks.nix (the optional wrapper). Nothing in this file is Hermes-specific; `hosts` names the agents a skill may declare itself scoped to, and `external_skills` the skills it may point at outside this repository.",
  "scope_fields": [
    "writes"
  ],
  "scope_required": true,
  "allowed_writes": {
    "project": [
      "none",
      "$PROJECT",
      "$ARTIFACTS",
      "$SCRATCH"
    ],
    "declared": [
      "$HERMES_HOME",
      "$XDG_CONFIG",
      "$SYSTEM"
    ]
  },
  "domain_contract": "CATEGORY.md",
  "aliases": "library/aliases.json",
  "fhs_fail_prefixes": [
    "/home"
  ],
  "fhs_note_prefixes": [
    "/usr",
    "/etc",
    "/var",
    "/opt",
    "/srv"
  ],
  "side_effects": [
    "none",
    "systemd",
    "container",
    "port",
    "cron",
    "background-process",
    "credential",
    "global-package"
  ],
  "container_runtime": {
    "primary": "podman",
    "fallback": "docker",
    "fallback_marker": "docker-fallback"
  },
  "provisioning": {
    "marker": "nix-provision",
    "doc": "docs/provisioning.md"
  }
}
